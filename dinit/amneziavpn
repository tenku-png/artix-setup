# AmneziaVPN daemon (from the upstream systemd unit). /etc/dinit.d/amneziavpn
type            = process
command         = /opt/AmneziaVPN/bin/AmneziaVPN-service
depends-on      = network.target
restart         = true
restart-delay   = 1
smooth-recovery = true
logfile         = /var/log/amneziavpn.log
