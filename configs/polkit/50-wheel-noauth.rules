// Let an active local wheel user mount removable filesystems, unlock a volume
// after supplying its passphrase, and set up loop devices for disk images.
// Keep destructive disk management, system drives and Flatpak actions under
// their normal policies. Libvirt socket access is configured separately.
polkit.addRule(function(action, subject) {
    if (!subject.isInGroup("wheel") || !subject.local || !subject.active)
        return polkit.Result.NOT_HANDLED;
    if ([
        "org.freedesktop.udisks2.filesystem-mount",
        "org.freedesktop.udisks2.encrypted-unlock",
        "org.freedesktop.udisks2.loop-setup"
    ].indexOf(action.id) !== -1)
        return polkit.Result.YES;
    return polkit.Result.NOT_HANDLED;
});
