# Clamp TCP MSS to the route MTU on VPN interfaces, so large transfers
# (video, downloads) do not stall when the tunnel MTU is smaller.
table inet vpn_mss {
	chain clamp_out {
		type filter hook output priority mangle; policy accept;
		oifname "amn*" tcp flags syn tcp option maxseg size set rt mtu
		oifname "tun*" tcp flags syn tcp option maxseg size set rt mtu
		oifname "wg*" tcp flags syn tcp option maxseg size set rt mtu
		oifname "awg*" tcp flags syn tcp option maxseg size set rt mtu
	}
	chain clamp_fwd {
		type filter hook forward priority mangle; policy accept;
		oifname "amn*" tcp flags syn tcp option maxseg size set rt mtu
		oifname "tun*" tcp flags syn tcp option maxseg size set rt mtu
		oifname "wg*" tcp flags syn tcp option maxseg size set rt mtu
		oifname "awg*" tcp flags syn tcp option maxseg size set rt mtu
	}
}
