#!/bin/bash
# fix <name>: run the latest <name>.sh from tenku-png/artix-setup
#   fix trim | gpu | update | lilith | lilith-new
R=tenku-png/artix-setup
name=${1:-}
case $name in
	gpu) name=gpu-check ;;
	update) name=fix ;;
	lilith-new) export LIWM_BRANCH=hyprland-config; name=lilith ;;
	""|-h|--help) echo "usage: fix trim | gpu | net | awg FILE | awgwatch | ramtop | slim | kmem | boot | nvcost | pcp | wpslim | ddc | kernel | update | lilith | lilith-new"; exit 0 ;;
esac
# newest commit (avoids the 5 min cache of the main branch)
sha=$(curl -fsSL "https://api.github.com/repos/$R/commits/main" 2>/dev/null | grep -m1 '"sha"' | cut -d'"' -f4)
shift
REF=${sha:-main} bash <(curl -fsSL "https://raw.githubusercontent.com/$R/${sha:-main}/$name.sh") "$@"
