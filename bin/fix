#!/bin/bash
# fix <name>: run the latest <name>.sh from tenku-png/artix-setup
#   fix trim | fix gpu | fix update
R=tenku-png/artix-setup
name=${1:-}
case $name in
	gpu) name=gpu-check ;;
	update) name=fix ;;
	""|-h|--help) echo "usage: fix trim | gpu | update"; exit 0 ;;
esac
# newest commit (avoids the 5 min cache of the main branch)
sha=$(curl -fsSL "https://api.github.com/repos/$R/commits/main" | grep -m1 '"sha"' | cut -d'"' -f4)
REF=${sha:-main} bash <(curl -fsSL "https://raw.githubusercontent.com/$R/${sha:-main}/$name.sh")
