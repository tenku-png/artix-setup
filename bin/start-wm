#!/bin/bash
# Start the chosen compositor from a TTY: start-wm [lilith|sway]
# Default comes from ~/.config/wm (written by install.sh).
WM=${1:-$(cat "$HOME/.config/wm" 2>/dev/null || echo lilith)}

# Both installed and no choice given: short menu on the console
if [ -z "${1:-}" ] && [ -t 0 ]; then
	printf '\n  1) lilith   2) sway   3) shell      [Enter or 3 s = %s] ' "$WM"
	read -r -t 3 c || c=
	case $c in 1) WM=lilith ;; 2) WM=sway ;; 3) WM=shell ;; esac
	echo
fi

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/runtime-$(id -u)}"
mkdir -p -m 700 "$XDG_RUNTIME_DIR"
export XDG_SESSION_TYPE=wayland MOZ_ENABLE_WAYLAND=1 QT_QPA_PLATFORM="wayland;xcb"
export ELECTRON_OZONE_PLATFORM_HINT=auto
# No accessibility bus (at-spi + its own dbus-daemon, ~20 MiB)
export NO_AT_BRIDGE=1 GTK_A11Y=none
# bemenu styled like the bar: one line on top, same font and colors
export BEMENU_OPTS="--fn 'JetBrainsMono Nerd Font 10' -H 24 -p '' --ignorecase \
 --tb '#222222' --tf '#eeeeee' --fb '#222222' --ff '#eeeeee' \
 --nb '#222222' --nf '#bbbbbb' --ab '#222222' --af '#bbbbbb' \
 --hb '#005577' --hf '#eeeeee' --sb '#005577' --sf '#eeeeee'"

SWAYFLAGS=
if grep -q '^nvidia_drm ' /proc/modules 2>/dev/null; then
	export GBM_BACKEND=nvidia-drm __GLX_VENDOR_LIBRARY_NAME=nvidia
	SWAYFLAGS=--unsupported-gpu
	# NVIDIA hardware cursor planes can draw the pointer offset from where it is
	export WLR_NO_HARDWARE_CURSORS=1
	# A leftover firmware framebuffer (simpledrm) can show up as card0 next
	# to the NVIDIA card; point wlroots at the NVIDIA card explicitly.
	for c in /sys/class/drm/card[0-9]; do
		if [ "$(basename "$(readlink "$c/device/driver" 2>/dev/null)")" = nvidia ]; then
			export WLR_DRM_DEVICES=/dev/dri/$(basename "$c")
			break
		fi
	done
fi

case "$WM" in
shell)
	exec "${SHELL:-/bin/bash}" ;;
lilith)
	export XDG_CURRENT_DESKTOP=wlroots
	# Real GPU: render on it (pixman = CPU rendering, only light enough in a
	# VM or on small screens). Override with WLR_RENDERER=pixman|gles2|vulkan.
	if [ -z "${WLR_RENDERER:-}" ]; then
		if [ -e /dev/dri/renderD128 ] && ! grep -qi -e virtio -e qxl -e bochs /sys/class/drm/card*/device/uevent 2>/dev/null; then
			export WLR_RENDERER=gles2
		else
			export WLR_RENDERER=pixman
		fi
	fi
	dbus-run-session lilith -s session-apps ;;
sway|swayfx)
	export XDG_CURRENT_DESKTOP=sway
	dbus-run-session sway $SWAYFLAGS ;;
*)
	echo "start-wm: unknown compositor '$WM' (lilith or sway)" >&2; exit 1 ;;
esac
rc=$?
if [ "$rc" -ne 0 ]; then
	printf '\n%s exited with error %s. Dropping to a shell (type exit to log out).\n' "$WM" "$rc"
	printf 'Checks:  fix gpu   |   lsmod | grep nvidia   |   start-wm sway\n'
	exec "${SHELL:-/bin/bash}"
fi
